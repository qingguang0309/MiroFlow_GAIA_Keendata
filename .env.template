# MiroFlow x keendata (GAIA) — environment template
# Copy to .env and fill in values. This file lists KEYS ONLY; .env and .env*.bak are gitignored — never commit them.
# Which block matters depends on the agent config you launch:
#   config/agent_gaia-validation-keendata-{sol,kimi,opus,solor}.yaml  (main/sub agent = the arm's model; aux roles = kimi-k3)

# ============================================================
# 1. Main / sub-agent LLM — one block per arm; the yaml's provider_class + env names select the block
# ============================================================
# --- gpt-5.6-sol arm (GPT5OpenAIClient) via the keendata router ---
# NOTE: two gateways exist with SEPARATE key databases (router.keendata.net:5343 vs router.keendata.com:5343);
#       a key valid on one returns 401 INVALID_API_KEY on the other. They share the same upstream pool.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://router.keendata.net:5343/v1

# --- kimi-k3 arm (GPTOpenAIClient) via Moonshot official API (the API forces temperature=1) ---
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# --- claude-opus-5 arm (ClaudeOpenRouterClient) and the "solor" fallback arm (openai/gpt-5.6-sol) via OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=
# ^ legacy: model name for tool-reasoning when it was pointed at OpenRouter; unused by the f-v2 wiring but harmless to keep.

# --- MUST BE DEFINED even if empty: tool yamls reference ${oc.env:ANTHROPIC_API_KEY} with no default and
#     OmegaConf raises on a missing variable. Empty string => VQA / reasoning fall back to the OpenAI-compatible path.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL_NAME=claude-3-7-sonnet-20250219

# ============================================================
# 2. Auxiliary roles: hint generation / answer-type / final-answer extraction (src/utils/summary_utils.py)
#    f-v2 wiring: ALL aux roles run on kimi-k3 via Moonshot, so the pipeline does not depend on the keendata router.
#    The agent yamls read the aux API key as ${oc.env:KIMI_API_KEY}; the variables below set base URL + model names.
#    (upstream defaults are o3 / gpt-4.1 at api.openai.com — they MUST be overridden when using any router)
# ============================================================
HINT_LLM_BASE_URL=https://api.moonshot.cn/v1
FINAL_ANSWER_LLM_BASE_URL=https://api.moonshot.cn/v1
HINT_LLM_MODEL_NAME=kimi-k3
ANSWER_TYPE_LLM_MODEL_NAME=kimi-k3
FINAL_ANSWER_LLM_MODEL_NAME=kimi-k3

# ============================================================
# 3. Tool servers (config/tool/*.yaml -> MCP subprocesses)
#    HTTP(S)_PROXY / NO_PROXY, if set, are propagated into MCP subprocesses (src/utils/tool_utils.py).
# ============================================================
# tool-reasoning.yaml and tool-image-video.yaml map their OpenAI-path credentials to KIMI_* (f-v2) and take the
# model from these (default kimi-k3):
# REASONING_MODEL_NAME=kimi-k3
# VQA_MODEL_NAME=kimi-k3
# Vision model used directly by tool-browsing.yaml / the vision server when VQA falls back to the OpenAI path
# (upstream default gpt-4o, which the router does not serve):
OPENAI_MODEL_NAME=kimi-k3
SERPER_API_KEY=
# ^ Google search + scrape fallback. The campaign monitor freezes runs when Serper credits drop below 3000.
JINA_API_KEY=
# ^ Jina Reader = primary web scraper in f-v2. Empty => scraping falls back to the Serper scrape chain.
E2B_API_KEY=
# ^ sandboxed Python execution (tool-code.yaml). Optional: DEFAULT_TEMPLATE_ID=all_pip_apt_pkg, DEFAULT_TIMEOUT
GEMINI_API_KEY=
# ^ VQA third fallback + YouTube video analysis (google-genai)
HF_TOKEN=
# ^ GAIA dataset download (utils/prepare_benchmark)

# ============================================================
# 4. Runtime switches — set on the LAUNCH COMMAND LINE (tmux does not inherit the caller's env; embed them)
# ============================================================
# FORCE_FIRST_TOOL_CALL=1      kimi arm only: tool_choice=required on each session's first turn (kimi sometimes refuses tools)
# AUX_LLM_CONCURRENCY=2        semaphore for aux-role LLM calls (code default 3); prevents launch bursts saturating upstream
# CLAUDE_THINKING_BUDGET=8192  opus arm: extended-thinking budget via OpenRouter's reasoning param (0 = off)
# CHINESE_CONTEXT=false        Chinese-context prompts
# DATA_DIR=data                dataset root (config default)

# ============================================================
# 5. Not used for GAIA (other benchmarks / alternative endpoints), listed for completeness
# ============================================================
# OAI_MIROTHINKER_API_KEY / OAI_MIROTHINKER_BASE_URL       self-hosted MiroThinker arm
# VISION_API_KEY / VISION_BASE_URL / VISION_MODEL_NAME     dedicated vision endpoint
# WHISPER_API_KEY / WHISPER_BASE_URL / WHISPER_MODEL_NAME  dedicated transcription endpoint
# REASONING_API_KEY / REASONING_BASE_URL                   dedicated reasoning endpoint (tool-reasoning-os.yaml)
# SERPER_BASE_URL / JINA_BASE_URL                          override provider endpoints
# REMOVE_SNIPPETS / REMOVE_KNOWLEDGE_GRAPH / REMOVE_ANSWER_BOX   Serper response trimming flags
